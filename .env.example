# ── API & Core ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
SECRET_KEY=super-secret-key-change-me

# ── Database & Redis ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/zapi.db
# DATABASE_URL=postgresql://user:pass@localhost/zapi
REDIS_URL=redis://localhost:6379/0

# ── YouTube ───────────────────────────────────────────────────────────────────
# Optional: Path to Netscape-format cookies.txt for age-gated videos
YOUTUBE_COOKIES_FILE=./data/cookies.txt

# (Facebook upload settings removed)

# ── Video Processing & Hardware ───────────────────────────────────────────────
OUTPUT_RESOLUTION=1080x1920
OUTPUT_FPS=30
OUTPUT_BITRATE=8000k
AUDIO_NORMALIZE=True
ADD_FADE_EFFECTS=True
FFMPEG_USE_HWACCEL=False
FFMPEG_HWACCEL_CODEC=h264_nvenc

# ── AI & Meta ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
ENABLE_REAL_WHISPER=False
ENABLE_LOCAL_WHISPER=False
ENABLE_AI_METADATA=False
ENABLE_AUTO_SUBTITLES=True

# ── Admin & UI ────────────────────────────────────────────────────────────────
ADMIN_UI_ENABLED=True
ENABLE_API_DOCS=True

# ── Rate Limiting ─────────────────────────────────────────────────────────────
SLOWAPI_RATE_LIMIT=60/minute
